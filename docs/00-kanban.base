        - Uncategorized
    collapsedLanes:
      "note.status\x1fnote.domain": []
      "note.status\x1fnote.type":
        - doc
        - glossary
      "note.status\x1fnote.board": []
    wrapPropertyValues: true
    swimlaneByProperty: note.type
    cardTitleProperty: note.title
    quickAddFolder: project-cards
