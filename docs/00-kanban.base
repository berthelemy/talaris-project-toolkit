    columnColors:
      file.file: {}
      note.status: {}
    groupByProperty: note.status
    swimlaneOrders:
      "note.status\x1fnote.domain":
        - docs
        - handoff
        - kanban
        - modules
        - planning
        - setup
        - ui
        - Uncategorized
